package ffrwd:whisper;

/// What the transcribe node imports beside the node world ffrwd-node
/// exports: `wasi:nn`, the standard interface, not anything of ours. It
/// imports no filesystem: the graph file is the host's, and this module only
/// knows the name it was bound to.
world transcribe {
  import wasi:nn/tensor@0.2.0-rc-2024-10-28;
  import wasi:nn/graph@0.2.0-rc-2024-10-28;
  import wasi:nn/inference@0.2.0-rc-2024-10-28;
  import wasi:nn/errors@0.2.0-rc-2024-10-28;
}
